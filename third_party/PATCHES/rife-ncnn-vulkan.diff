+    const int px=(int)a.elemsize;const bool bytes=opt.use_fp16_storage&&opt.use_int8_storage;
+    if((px!=3&&px!=4)||(int)b.elemsize!=px||(int)output.elemsize!=px||(px==4&&(!bytes||!rife_preproc4||!rife_postproc4)))return -1;
